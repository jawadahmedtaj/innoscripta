{
  "name": "baseline-planning-suite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.20.0", "npm": "11.19.0" },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:domain": "vitest run packages/domain",
    "test:integration": "vitest run tests/integration packages/data",
    "build": "rspack build --config rspack.config.mjs",
    "start": "node scripts/serve.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": { "react": "19.3.0", "react-dom": "19.3.0" },
  "devDependencies": {
    "@rspack/cli": "2.2.8", "@rspack/core": "2.2.8",
    "@testing-library/react": "16.3.3", "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.1", "@types/react": "19.3.0", "@types/react-dom": "19.3.0",
    "eslint": "9.39.1", "jsdom": "30.1.2", "typescript": "5.9.3",
    "typescript-eslint": "8.71.1", "vitest": "5.0.3"
  }
}
