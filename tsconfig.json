{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".", "paths": {
      "@baseline/contracts": ["packages/contracts/src/index.ts"],
      "@baseline/domain": ["packages/domain/src/index.ts"],
      "@baseline/data": ["packages/data/src/index.ts"],
      "@baseline/platform": ["packages/platform/src/index.ts"]
    }
  },
  "include": ["apps", "packages", "tests", "vitest.config.ts"]
}
